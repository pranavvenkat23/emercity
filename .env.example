# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app config.
# These identify the Firebase project; security comes from Firestore rules, not from hiding them.
# Still, .env is git-ignored so per-developer projects stay separate.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
