rules_version = '2';

// Emercity Firestore security rules, spec §19.3, §22.4, §24.5.
//
// Runs on the free Spark plan: there are no Cloud Functions, so creating a
// household and joining with an invite are client writes these rules
// validate. Tested with the emulator in `firestore-rules.test.ts`.
//
// Model: households/{hid}.roles is a map { uid: 'owner' | 'adult' | 'teen' }.
// Membership is checked on every read/write; signing in alone grants nothing.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function householdDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid));
    }
    function roleIn(hid) {
      let h = householdDoc(hid);
      return signedIn() && h != null && h.data.roles != null && uid() in h.data.roles ? h.data.roles[uid()] : null;
    }
    function isMember(hid) { return roleIn(hid) != null; }
    function isOwner(hid)  { return roleIn(hid) == 'owner'; }
    function isAdult(hid)  { return roleIn(hid) in ['owner', 'adult']; }
    function isTeen(hid)   { return roleIn(hid) == 'teen'; }

    // The user's own profile says whether they confirmed 18+ (§5.2 age gate).
    function userIsAdult() {
      let u = get(/databases/$(database)/documents/users/$(uid()));
      return u != null && u.data.isAdult18Plus == true;
    }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(fields) { return changed().hasOnly(fields); }
    function rolesChanged() { return request.resource.data.roles.diff(resource.data.roles).affectedKeys(); }

    // ── Users: each user reads/writes only their own profile ──
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ── Invites (HH-10, §19.2). Readable one at a time by code, never listed ──
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() == 8
        && isAdult(request.resource.data.householdId)
        && request.resource.data.createdBy == uid()
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow delete: if signedIn() && isAdult(resource.data.householdId);
      allow update: if false;
    }

    // ── Household root ──
    match /households/{hid} {
      allow read: if isMember(hid);

      // Created by an adult who becomes its only owner (§19.1).
      allow create: if signedIn()
        && userIsAdult()
        && request.resource.data.id == hid
        && request.resource.data.ownerUserId == uid()
        && request.resource.data.roles == { (uid()): 'owner' }
        && request.resource.data.isDemo == false;

      allow update: if
        // Owner: anything except moving ownership away by accident (roles keep an owner).
        (isOwner(hid) && request.resource.data.roles[request.resource.data.ownerUserId] == 'owner')
        // Adults: plan fields, not roles/owner/demo flag (§19.3).
        || (isAdult(hid) && !changed().hasAny(['roles', 'ownerUserId', 'isDemo', 'joinCode']))
        // Joining with a valid, unexpired invite: add only yourself, as
        // adult or teen according to your own age answer (§19.2).
        || (signedIn() && !isMember(hid)
            && onlyChanges(['roles', 'joinCode'])
            && rolesChanged().hasOnly([uid()])
            && request.resource.data.roles[uid()] == (userIsAdult() ? 'adult' : 'teen')
            && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.householdId == hid
            && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.expiresAt > request.time)
        // Leaving: a non-owner removes only themselves.
        || (isMember(hid) && !isOwner(hid)
            && onlyChanges(['roles', 'updatedAt', 'updatedBy', 'id'])
            && rolesChanged().hasOnly([uid()])
            && !(uid() in request.resource.data.roles));

      allow delete: if false; // 30-day soft delete (§22.3)

      // Members: adults edit all; teens edit only their own record; anyone
      // in the household may link an unlinked member record to themselves
      // after joining ("I'm Rohan", §19.2).
      match /members/{mid} {
        allow read: if isMember(hid);
        allow create: if isAdult(hid);
        allow update: if isAdult(hid)
          || (isTeen(hid) && resource.data.linkedUserId == uid()
              && !changed().hasAny(['linkedUserId', 'householdId']))
          || (isMember(hid) && resource.data.linkedUserId == null
              && request.resource.data.linkedUserId == uid()
              && onlyChanges(['linkedUserId', 'updatedAt', 'updatedBy']));
        allow delete: if false;
      }

      // Adults edit; teens read (§19.3).
      match /medications/{id}   { allow read: if isMember(hid); allow create, update: if isAdult(hid); allow delete: if false; }
      match /devices/{id}       { allow read: if isMember(hid); allow create, update: if isAdult(hid); allow delete: if false; }
      match /pets/{id}          { allow read: if isMember(hid); allow create, update: if isAdult(hid); allow delete: if false; }
      match /contacts/{id}      { allow read: if isMember(hid); allow create, update: if isAdult(hid); allow delete: if false; }
      match /meetingPoints/{id} { allow read: if isMember(hid); allow create, update: if isAdult(hid); allow delete: if false; }
      match /tasks/{id}         { allow read: if isMember(hid); allow create, update: if isAdult(hid); allow delete: if false; }

      // Supplies: adults edit; teens may only check items off (§19.3).
      match /supplies/{id} {
        allow read: if isMember(hid);
        allow create: if isAdult(hid);
        allow update: if isAdult(hid)
          || (isTeen(hid) && onlyChanges(['quantityHave', 'lastCheckedDate', 'updatedAt', 'updatedBy']));
        allow delete: if false;
      }

      // Drills: any member may run one (§19.3).
      match /drills/{id} { allow read, create, update: if isMember(hid); allow delete: if false; }

      // Emergency sessions: any member may start and record steps; only
      // adults end it for everyone (§19.3).
      match /sessions/{sid} {
        allow read, create: if isMember(hid);
        allow update: if isAdult(hid) || (isMember(hid) && !changed().hasAny(['endedAt', 'outcome']));
        allow delete: if false;
      }
      match /checkIns/{cid} { allow read, create, update: if isMember(hid); allow delete: if false; }
    }

    // ── Reference data: read-only for signed-in users (§24.5) ──
    match /reference/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
